<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: left Netflix-red accent bar + slightly lighter surface -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Red left accent bar -->
            <item android:width="4dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/netflix_red" />
                </shape>
            </item>
            <!-- Background fill -->
            <item android:left="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2A2A2A" />
                    <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default: subtle dark surface with thin left border -->
    <item>
        <layer-list>
            <item android:width="4dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="#333333" />
                </shape>
            </item>
            <item android:left="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_surface" />
                    <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
