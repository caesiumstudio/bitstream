<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: solid Netflix red with rounded corners -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/netflix_red" />
            <stroke android:width="0dp" android:color="@color/netflix_red" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Default: dashed-border card styled as an "add" affordance -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1F1F1F" />
            <stroke android:width="2dp" android:color="#444444" android:dashWidth="8dp" android:dashGap="4dp" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>
