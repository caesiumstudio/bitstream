<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/default_background">

    <!-- ═══════════════════════════════════════════════
         Top navigation bar — Netflix-style header
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/fastlane_background"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center_vertical">

        <!-- App wordmark / logo -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="BitStream"
            android:textColor="@color/netflix_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:focusable="false" />

        <!-- Nav tabs grouped to the right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/nav_home"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="100dp"
                android:text="HOME"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="normal"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:focusable="true"
                android:background="@drawable/nav_tab_background" />

            <TextView
                android:id="@+id/nav_settings"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="100dp"
                android:text="SETTINGS"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="normal"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:focusable="true"
                android:background="@drawable/nav_tab_background" />

            <TextView
                android:id="@+id/nav_exit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="80dp"
                android:text="EXIT"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="normal"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:focusable="true"
                android:background="@drawable/nav_tab_background" />

        </LinearLayout>
    </LinearLayout>

    <!-- Thin separator line below nav -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ═══════════════════════════════════════════════
         Content area
         ═══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Home: site tile grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sites_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:descendantFocusability="afterDescendants"
            android:nextFocusUp="@id/nav_home"
            android:visibility="visible" />

        <!-- Settings panel -->
        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <!-- Section header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PREFERENCES"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="16dp"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/setting_cursor_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pointer Speed: Normal (1×)"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:focusable="true"
                    android:background="@drawable/settings_item_background"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/setting_scroll_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scroll Speed: Normal (1×)"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:focusable="true"
                    android:background="@drawable/settings_item_background"
                    android:layout_marginBottom="10dp" />

                <!-- Section header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ABOUT"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/setting_check_updates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check for Updates"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:focusable="true"
                    android:background="@drawable/settings_item_background"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
